{
  "name": "@webship.co/workspace-upsun",
  "version": "1.0.2",
  "description": "Upsun for Webship Workspace: the UPSUN menu on every site row, environments and live URLs, get database and files, deploy, activities and logs, link from the command line, the upsun CLI in the dashboard container. A provider of @webship.co/workspace-hosting.",
  "main": "dist/src/index.js",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-upsun.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "upsun",
    "label": "Upsun",
    "settingsFile": "plugin.upsun.settings.yml",
    "settingsTemplate": "config/plugin.upsun.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "upsun",
    "typeActions": {
      "upsun": [
        "sites"
      ]
    },
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "demos",
        "sandboxes",
        "projects"
      ],
      "files": [
        "commands/cmd-tools-upsun.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-upsun.sh"
      ],
      "args": [
        "scripts/args/arg-upsun.sh"
      ],
      "machine": [
        "scripts/upsun-ai.sh"
      ],
      "hostInstall": "scripts/host-install.sh"
    },
    "ddev": {
      "compose": [
        "ddev/docker-compose.upsun-cli.yaml"
      ],
      "hostMounts": [
        "~/.upsun-cli"
      ]
    },
    "themes": [
      "config/theme.upsun.yml"
    ],
    "features": [
      "features/upsun.feature"
    ]
  },
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "commands",
    "config",
    "ddev",
    "features",
    "scripts",
    "host-mounts.txt",
    "README.md"
  ],
  "dependencies": {
    "@webship.co/workspace-hosting": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
