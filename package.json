{
  "name": "@webship/workspace-upsun",
  "version": "1.1.0",
  "description": "Upsun for Webship Workspace: the UPSUN menu on every site row, environments and live URLs, get database and files, link and deploy from the command line, the upsun CLI in the dashboard container.",
  "main": "dist/src/index.js",
  "private": true,
  "license": "ISC",
  "repository": "github:webship/workspace-upsun",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "upsun",
    "label": "Upsun",
    "settingsFile": "plugin.upsun.settings.yml",
    "settingsTemplate": "config/plugin.upsun.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "upsun",
    "typeActions": {
      "upsun": [
        "sites"
      ]
    },
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "demos",
        "sandboxes",
        "projects"
      ],
      "files": [
        "commands/cmd-tools-upsun.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-upsun.sh"
      ],
      "args": [
        "scripts/args/arg-upsun.sh"
      ],
      "machine": [
        "scripts/upsun-ai.sh"
      ],
      "hostInstall": "scripts/host-install.sh"
    },
    "ddev": {
      "compose": [
        "ddev/docker-compose.upsun-cli.yaml"
      ],
      "hostMounts": [
        "~/.upsun-cli"
      ]
    },
    "themes": [
      "config/theme.upsun.yml"
    ],
    "css": [
      "public/upsun.css"
    ],
    "features": [
      "features/upsun.feature"
    ]
  },
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "commands",
    "config",
    "ddev",
    "public",
    "scripts",
    "host-mounts.txt",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship/workspace-plugin-api": "github:webship/workspace-plugin-api#1.0.x",
    "typescript": "^5.9.0"
  }
}
